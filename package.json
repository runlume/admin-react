{
  "name": "@runlume/admin-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Runlume 标准后台应用：路由、菜单、会话接线与标准页面的参考实现",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src README.md README.en.md AGENTS.md vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src README.md README.en.md AGENTS.md vite.config.ts playwright.config.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "verify": "pnpm check && pnpm test:e2e",
    "screenshots": "SCREENSHOTS=1 pnpm test:e2e -- --output=/tmp/pw-admin-react-out"
  },
  "dependencies": {
    "@runlume/admin-ui": "^0.3.0",
    "@tanstack/react-table": "8.21.3",
    "i18next": "26.4.2",
    "lucide-react": "1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "17.0.13",
    "react-router": "7.18.3",
    "sonner": "2.0.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/geist": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "30.0.1",
    "oxlint": "^1.81.0",
    "prettier": "3.9.6",
    "react-hook-form": "7.87.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.0",
    "zod": "4.6.1"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
